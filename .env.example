###############
# 大模型配置
###############
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=qwen-plus
LLM_FAST_MODEL=qwen-plus

###############
# 数据库配置
###############
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=travel_rag
DB_POOL_SIZE=8

###############
# 和风天气 API
###############
WEATHER_API_KEY=your-qweather-api-key-here
QWEATHER_API_HOST=your-qweather-api-host
WEATHER_CACHE_TTL_SECONDS=10800
DIRECT_CACHE_TTL_SECONDS=10800

###############
# 服务端口（一般不需要改）
###############
MCP_TICKET_PORT=8001
MCP_WEATHER_PORT=8002
MCP_ORDER_PORT=8003
MCP_HOTEL_PORT=8004
A2A_WEATHER_PORT=5005
A2A_TICKET_PORT=5006
A2A_ORDER_PORT=5007
A2A_HOTEL_PORT=5008
A2A_ITINERARY_PORT=5009

###############
# 服务地址（本地默认即可；Docker 部署时填 compose 服务名）
###############
MCP_TICKET_URL=http://localhost:8001/mcp
MCP_WEATHER_URL=http://localhost:8002/mcp
MCP_ORDER_URL=http://localhost:8003/mcp
MCP_HOTEL_URL=http://localhost:8004/mcp
A2A_WEATHER_URL=http://localhost:5005
A2A_TICKET_URL=http://localhost:5006
A2A_ORDER_URL=http://localhost:5007
A2A_HOTEL_URL=http://localhost:5008
A2A_ITINERARY_URL=http://localhost:5009

###############
# 限流存储（可选；多实例部署时填 Redis 地址）
###############
REDIS_URL=

# 前端 CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

###############
# 用户认证
###############
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRE_HOURS=24

###############
# 聚美智数/阿里云 真实火车票余票查询（可选，配好后票务查询优先走真实接口）
###############
ALIYUN_APPCODE=your-aliyun-appcode
ALIYUN_TRAIN_API_URL=https://jmhccx.market.alicloudapi.com/train-query/ticket
# aliyun=只查真实票源；auto=接口失败时降级本地演示数据；local/db/mysql=只用本地/演示数据
TRAIN_QUERY_SOURCE=aliyun
TRAIN_CACHE_TTL_SECONDS=120
TRAIN_RATE_MAX_PER_MINUTE=12

###############
# 极速数据/阿里云 备用真实余票（聚美接口不可用时自动切换，可选）
###############
JISU_APPCODE=your-jisu-appcode
JISU_TRAIN_API_URL=https://jisutrain.market.alicloudapi.com/train/ticket
