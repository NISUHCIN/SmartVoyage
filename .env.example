###############
# 大模型配置
###############
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=qwen-plus
LLM_FAST_MODEL=qwen-plus

###############
# 数据库配置
###############
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=travel_rag

###############
# 和风天气 API
###############
WEATHER_API_KEY=your-qweather-api-key-here
QWEATHER_API_HOST=your-qweather-api-host
WEATHER_CACHE_TTL_SECONDS=10800
DIRECT_CACHE_TTL_SECONDS=10800

###############
# 服务端口（一般不需要改）
###############
MCP_TICKET_PORT=8001
MCP_WEATHER_PORT=8002
MCP_ORDER_PORT=8003
MCP_HOTEL_PORT=8004
A2A_WEATHER_PORT=5005
A2A_TICKET_PORT=5006
A2A_ORDER_PORT=5007
A2A_HOTEL_PORT=5008
A2A_ITINERARY_PORT=5009

###############
# 服务地址（本地默认即可；Docker 部署时填 compose 服务名）
###############
MCP_TICKET_URL=http://localhost:8001/mcp
MCP_WEATHER_URL=http://localhost:8002/mcp
MCP_ORDER_URL=http://localhost:8003/mcp
MCP_HOTEL_URL=http://localhost:8004/mcp
A2A_WEATHER_URL=http://localhost:5005
A2A_TICKET_URL=http://localhost:5006
A2A_ORDER_URL=http://localhost:5007
A2A_HOTEL_URL=http://localhost:5008
A2A_ITINERARY_URL=http://localhost:5009

###############
# 限流存储（可选；多实例部署时填 Redis 地址）
###############
REDIS_URL=

###############
# 用户认证
###############
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRE_HOURS=24
